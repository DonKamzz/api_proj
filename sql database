/* =====================================================================
   RaceDay - Database Verification Queries
   Run these in SSMS AFTER executing raceday_schema.sql, to confirm the
   database, tables, and seed data are all in place.
   ===================================================================== */

-- 1. Confirm all six tables exist
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_TYPE = 'BASE TABLE'
ORDER BY TABLE_NAME;
GO

-- 2. Row count per table (quick sanity check that seed data loaded)
SELECT 'Users'       AS TableName, COUNT(*) AS RowCount FROM Users
UNION ALL SELECT 'Events',      COUNT(*) FROM Events
UNION ALL SELECT 'Categories',  COUNT(*) FROM Categories
UNION ALL SELECT 'Routes',      COUNT(*) FROM Routes
UNION ALL SELECT 'Enrolments',  COUNT(*) FROM Enrolments
UNION ALL SELECT 'Results',     COUNT(*) FROM Results;
GO

-- 3. View each table's contents individually
SELECT * FROM Users;
SELECT * FROM Events;
SELECT * FROM Categories;
SELECT * FROM Routes;
SELECT * FROM Enrolments;
SELECT * FROM Results;
GO

-- 4. Confirm primary keys, foreign keys, and constraints were created
SELECT
    tc.CONSTRAINT_NAME,
    tc.TABLE_NAME,
    tc.CONSTRAINT_TYPE
FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc
ORDER BY tc.TABLE_NAME, tc.CONSTRAINT_TYPE;
GO

-- 5. Relationship test: join across all six tables for a full picture
--    of who is enrolled in what, under which category, and their result.
SELECT
    U.FirstName + ' ' + U.LastName     AS Participant,
    E.Name                              AS EventName,
    E.EventType,
    C.CategoryName,
    EN.EnrolmentStatus,
    R.FinishTimeSeconds,
    R.FinishPosition,
    R.TotalFinishers
FROM Enrolments EN
JOIN Users U       ON EN.ParticipantID = U.UserID
JOIN Events E      ON EN.EventID = E.EventID
JOIN Categories C  ON EN.CategoryID = C.CategoryID
LEFT JOIN Results R ON R.EnrolmentID = EN.EnrolmentID
ORDER BY E.Name, C.CategoryName;
GO

-- 6. Confirm each Event's Organiser resolves correctly
SELECT
    E.Name       AS EventName,
    E.EventDate,
    E.Location,
    U.FirstName + ' ' + U.LastName AS Organiser
FROM Events E
JOIN Users U ON E.OrganiserID = U.UserID
ORDER BY E.EventDate;
GO

-- 7. Confirm each Event's Routes
SELECT
    E.Name       AS EventName,
    RT.RouteName,
    RT.DistanceKm,
    RT.StartPoint,
    RT.EndPoint
FROM Routes RT
JOIN Events E ON RT.EventID = E.EventID
ORDER BY E.Name;
GO

